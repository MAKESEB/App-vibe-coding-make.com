[
  {
    "name": "channelName",
    "type": "text",
    "label": "Channel Name",
    "required": true,
    "help": "Ably channel name to publish to."
  },
  {
    "name": "name",
    "type": "text",
    "label": "Event Name",
    "help": "Optional Ably message name/event type."
  },
  {
    "name": "data",
    "type": "any",
    "label": "Data",
    "required": true,
    "help": "Message payload. Use text, JSON, number, boolean, or another Make value."
  },
  {
    "name": "clientId",
    "type": "text",
    "label": "Client ID",
    "help": "Optional client ID associated with this message."
  },
  {
    "name": "extras",
    "type": "collection",
    "label": "Extras",
    "help": "Optional Ably message extras object."
  }
]
